# 统一换行规范：仓库内统一存 LF，避免 Windows 导出的 CRLF
# 把 gradlew 坏掉（Linux runner 上会 bad interpreter）。
* text=auto

# 必须 LF：脚本类文件
gradlew text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.kts text eol=lf
*.kt text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.properties text eol=lf

# 必须 CRLF：Windows 批处理
gradlew.bat text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.webp binary
*.gif binary
*.ttf binary
*.so binary
*.jar binary
*.aar binary
*.zip binary
*.keystore binary
*.jks binary

# Baseline Profile 生成文件：标记为文本，统一使用 LF 换行，避免 CRLF 抖动
app/src/release/generated/baselineProfiles/*.txt text eol=lf
